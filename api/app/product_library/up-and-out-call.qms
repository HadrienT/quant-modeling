# title: Up-and-out call
# category: Barriers and touch options
# underlyings: 1
# source: Rubinstein & Reiner, Breaking Down the Barriers, Risk, 1991
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: A call that dies if the stock ever closes at or above the barrier.
# param: strike = 1.0 | percent | Strike, % of the initial level
# param: barrier = 1.3 | percent | Knock-out barrier, % of the initial level
#
# Barrier checked at every close (a daily grid approximates continuous
# monitoring). No rebate.

2027-01-04
    strike = 1.0
    barrier = 1.3
    s0 = spot()
    alive = 1

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    if spot() >= barrier * s0 then alive = 0 endIf

2028-01-04
    if spot() >= barrier * s0 then alive = 0 endIf
    if alive = 1 then pays max(spot() - strike * s0, 0) endIf
