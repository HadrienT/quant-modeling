# title: Twin-win certificate
# category: Structured notes
# underlyings: 1
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Gains whichever way the stock moves, as long as it never closes at or below the barrier.
# param: notional = 1000 | amount | Notional
# param: barrier = 0.7 | percent | Barrier, % of the initial level
#
# Above the barrier the investor earns the absolute performance; once
# touched, plain stock.

2027-01-04
    notional = 1000
    barrier = 0.7
    s0 = spot()
    hit = 0

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    if spot() <= barrier * s0 then hit = 1 endIf

2028-01-04
    if spot() <= barrier * s0 then hit = 1 endIf
    if hit = 0 then
        pays notional * (1 + abs(spot() / s0 - 1))
    else
        pays notional * spot() / s0
    endIf
