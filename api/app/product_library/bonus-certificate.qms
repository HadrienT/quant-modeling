# title: Bonus certificate
# category: Structured notes
# underlyings: 1
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Tracks the stock, but pays at least the bonus level if it never closes at or below the barrier.
# param: notional = 1000 | amount | Notional
# param: bonus = 1.2 | percent | Bonus level, % of the initial level
# param: barrier = 0.7 | percent | Barrier, % of the initial level
#
# Once the barrier is touched the certificate is plain stock.

2027-01-04
    notional = 1000
    bonus = 1.2
    barrier = 0.7
    s0 = spot()
    hit = 0

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    if spot() <= barrier * s0 then hit = 1 endIf

2028-01-04
    if spot() <= barrier * s0 then hit = 1 endIf
    if hit = 0 then
        pays notional * max(spot() / s0, bonus)
    else
        pays notional * spot() / s0
    endIf
