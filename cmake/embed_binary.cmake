# Embed a binary file as a C array (lot P1b of blueprint/wp/26-performance.md:
# the LTO-IR fatbin of src/gpu/script_jit_kernel.cu, linked at run time).
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P embed_binary.cmake
# defines  extern "C" const unsigned char <name>[];
#          extern "C" const unsigned long long <name>_size;
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _len)
math(EXPR _size "${_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" _bytes "${_bytes}")
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/embed_binary.cmake from ${INPUT}; do not edit.\n"
  "extern \"C\" const unsigned long long ${SYMBOL}_size = ${_size}ull;\n"
  "extern \"C\" alignas(16) const unsigned char ${SYMBOL}[] = {\n${_bytes}\n};\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
