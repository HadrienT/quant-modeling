# Brings the production stack up on boot and keeps it defined across reboots,
# even after a manual `docker compose down`. The containers themselves carry
# `restart: unless-stopped`, so this unit is belt-and-braces.
#
# Install:
#   sudo cp deploy/quant-modeling.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now quant-modeling.service
#
# The worktree path below must match where `git worktree add` put it.

[Unit]
Description=quant-modeling production stack (docker compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/hadriensuper/quant-modeling-prod
# The tunnel lives in the `tunnel` compose profile; the site is unreachable
# without it, so the boot unit always includes it.
Environment=COMPOSE_PROFILES=tunnel
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
