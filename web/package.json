{
	"name": "quant-modeling-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"packageManager": "npm@10.8.2",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
