		"test": "vitest run",
		"test:watch": "vitest",
		"api:types": "openapi-typescript ${QM_OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/shared/api/schema.gen.ts",
		"api:types:local": "openapi-typescript openapi.json -o src/shared/api/schema.gen.ts",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"palette": "node scripts/validate_palette.js",
		"size": "size-limit"
	},
