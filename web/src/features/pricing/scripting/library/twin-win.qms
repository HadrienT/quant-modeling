# title: Twin-win certificate
# category: Structured notes
# underlyings: 1
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Gains whichever way the stock moves, as long as it never closes at or below 70%: a fall of 10% pays +10%.
#
# Notional 1000. Barrier 70% (daily closes). Above it the investor earns
# the absolute performance; once touched, plain stock.

2027-01-04
    s0 = spot()
    hit = 0

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    if spot() <= 0.70 * s0 then hit = 1 endIf

2028-01-04
    if spot() <= 0.70 * s0 then hit = 1 endIf
    if hit = 0 then
        pays 1000 * (1 + abs(spot() / s0 - 1))
    else
        pays 1000 * spot() / s0
    endIf
