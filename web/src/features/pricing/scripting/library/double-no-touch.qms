# title: Double no-touch
# category: Barriers and touch options
# underlyings: 1
# source: Reiner & Rubinstein, Unscrambling the Binary Code, Risk, 1991
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Pays 100 if the stock stays strictly between 85% and 115% of its initial level at every close: a bet on low volatility.
#
# Range: 85% to 115% of the strike-date level, daily closes, six months.

2027-01-04
    s0 = spot()
    inside = 1

schedule(2027-01-05, 2027-06-30, 1D, US, F)
    if spot() <= 0.85 * s0 or spot() >= 1.15 * s0 then inside = 0 endIf

2027-07-06
    if spot() <= 0.85 * s0 or spot() >= 1.15 * s0 then inside = 0 endIf
    if inside = 1 then pays 100 endIf
