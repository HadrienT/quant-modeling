# title: Altiplano
# category: Multi-asset
# underlyings: 3
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: A capital-protected note paying a 20% coupon if none of three stocks ever closes a month below 80%; otherwise a basket call instead.
#
# Notional 1000, monthly monitoring of each stock against 80% of its own
# strike-date level.

2027-01-04
    s0 = spot(0)
    s1 = spot(1)
    s2 = spot(2)
    breached = 0

schedule(2027-02-04, 2027-12-04, 1M, US, F)
    if spot(0) < 0.80 * s0 or spot(1) < 0.80 * s1 or spot(2) < 0.80 * s2 then breached = 1 endIf

2028-01-04
    if spot(0) < 0.80 * s0 or spot(1) < 0.80 * s1 or spot(2) < 0.80 * s2 then breached = 1 endIf
    basket = (spot(0) / s0 + spot(1) / s1 + spot(2) / s2) / 3
    if breached = 0 then
        pays 1000 * 1.20
    else
        pays 1000 * (1 + max(basket - 1, 0))
    endIf
