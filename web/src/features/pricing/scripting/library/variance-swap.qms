# title: Variance swap
# category: Volatility
# underlyings: 1
# source: Demeterfi, Derman, Kamal & Zou, A Guide to Volatility and Variance Swaps, Journal of Derivatives, 1999
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Exchanges the realised variance of daily returns over a year for a fixed 20% volatility strike.
#
# Realised variance = 252 / n x sum of squared daily log returns (zero
# mean). Variance notional 10,000: pays 10,000 x (realised variance - 0.2^2).

2027-01-04
    prev = spot()
    sumsq = 0
    n = 0

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    sumsq = sumsq + log(spot() / prev) ^ 2
    n = n + 1
    prev = spot()

2028-01-04
    sumsq = sumsq + log(spot() / prev) ^ 2
    n = n + 1
    pays 10000 * (252 * sumsq / n - 0.20 ^ 2)
