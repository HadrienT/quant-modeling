# title: One-touch (down)
# category: Barriers and touch options
# underlyings: 1
# source: Reiner & Rubinstein, Unscrambling the Binary Code, Risk, 1991
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: Pays 100 at maturity if the stock closes at or below 80% of its initial level at least once.
#
# Touch level: 80% of the strike-date level, daily closes; paid at maturity
# (not when touched).

2027-01-04
    s0 = spot()
    touched = 0

schedule(2027-01-05, 2027-12-30, 1D, US, F)
    if spot() <= 0.80 * s0 then touched = 1 endIf

2028-01-04
    if spot() <= 0.80 * s0 then touched = 1 endIf
    if touched = 1 then pays 100 endIf
