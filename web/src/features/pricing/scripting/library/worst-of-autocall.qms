# title: Worst-of Phoenix autocall
# category: Multi-asset
# underlyings: 3
# source: Bouzoubaa & Osseiran, Exotic Options and Hybrids: A Guide to Structuring, Pricing and Trading, Wiley, 2010
# summary: The most traded structured product: quarterly 2.5% coupons while the worst of three stocks is above 70%, early redemption above 100%, capital at risk below 60% at maturity.
#
# Notional 1000, two years, quarterly observations on the worst performer.
# No coupon memory.

2027-01-04
    s0 = spot(0)
    s1 = spot(1)
    s2 = spot(2)
    alive = 1

schedule(2027-04-05, 2028-10-04, 3M, US, F)
    worst = min(spot(0) / s0, min(spot(1) / s1, spot(2) / s2))
    if alive = 1 then
        if worst >= 1 then
            pays 1000 * 1.025
            alive = 0
        else
            if worst >= 0.70 then pays 1000 * 0.025 endIf
        endIf
    endIf

2029-01-04
    worst = min(spot(0) / s0, min(spot(1) / s1, spot(2) / s2))
    if alive = 1 then
        if worst >= 0.70 then
            pays 1000 * 1.025
        else
            if worst < 0.60 then pays 1000 * worst else pays 1000 endIf
        endIf
    endIf
