limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;

# gzip everything text-ish (the stock `gzip on;` is stripped in the Dockerfile so
# this block is the single source of truth)
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json
           image/svg+xml application/wasm font/woff2;
gzip_vary on;

# The request reaches nginx over plain HTTP (from cloudflared on the compose
# network), but the browser terminated TLS at Cloudflare. Trust the proto the
# edge reports; fall back to the scheme nginx itself saw if the header is absent.
map $http_x_forwarded_proto $forwarded_proto {
    default    $scheme;
    "~^https?$" $http_x_forwarded_proto;
}

# The real client address. The request reaches nginx from cloudflared over the
# compose network, so $remote_addr was cloudflared's container: every visitor
# shared one rate-limit bucket (a cold page load of ~25 lazy chunks drew 503s)
# and one audit ip_hash. Cloudflare puts the visitor's address in
# CF-Connecting-IP; trust it only from private (compose / loopback) peers.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
real_ip_header   CF-Connecting-IP;

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers — see the snippet's comment: nginx does not merge
    # add_header across levels, so every location that sets a header of its own
    # must include this again.
    include /etc/nginx/snippets/security-headers.conf;

    # ── shared proxy headers (inherited by every location that proxies) ──
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $forwarded_proto;

    # ── health check — proxied to the API ────────────────────────
    location = /health {
        proxy_pass ${API_URL}/health;
    }

    # ── runtime config — read by the app before its first request ─
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    # ── reverse-proxy /api → backend API ────────────────────────
    # Rate-limited per visitor here, where requests cost CPU. Not the static
    # files: the hashed assets are served from disk, and a first visit loads
    # dozens of them at once.
    location /api/ {
        limit_req          zone=per_ip burst=20 nodelay;
        proxy_pass         ${API_URL}/api/;
        proxy_read_timeout 180s;
    }
    location ~ ^/(market|price)/ {
        limit_req          zone=per_ip burst=20 nodelay;
        proxy_pass         ${API_URL};
        proxy_read_timeout 180s;
    }

    # ── Block scanner/bot paths ─────────────────────────────────
    location ~* \.(php|asp|aspx|jsp|cgi|env|git)$ { return 444; }
    location ~* ^/(wp-admin|wp-includes|wp-content|wp-login|wordpress|xmlrpc|phpmyadmin|admin|administrator|cgi-bin) { return 444; }

    # ── SPA fallback ───────────────────────────────────────────
    location / {
        limit_except GET HEAD OPTIONS { deny all; }
        try_files $uri $uri/ /index.html;
    }

    # ── never cache the shell ──────────────────────────────────
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ── immutable hashed assets (filename carries a content hash) ──
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
