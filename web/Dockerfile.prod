### ── Stage 1: Build the C++ quantModeling Python wheel ──────────
FROM python:3.12-slim AS cpp-builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libeigen3-dev pybind11-dev ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml CMakeLists.txt README.md ./
COPY bindings ./bindings
COPY include ./include
COPY src ./src

RUN python -m pip install --upgrade pip --root-user-action=ignore \
    && python -m pip install --root-user-action=ignore "scikit-build-core>=0.10.2" "pybind11>=3.0.1" build \
    && python -m build --wheel

### ── Stage 2: Build the frontend with Vite ─────────────────────
FROM node:20.19-alpine AS frontend-builder

WORKDIR /app
COPY web/package.json web/package-lock.json web/.npmrc ./
RUN npm ci

COPY web/ ./
# No VITE_API_BASE / VITE_API_KEY: config is read at RUNTIME from /config.json
# (blueprint WP 14 §1, ADR-008). Only the commit SHA is a build-time value.
ARG VITE_COMMIT_SHA=dev
ENV VITE_COMMIT_SHA=${VITE_COMMIT_SHA}
RUN npm run build

### ── Stage 3: Runtime — nginx + uvicorn ────────────────────────
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx bash curl ca-certificates gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    # Debian ships a default :80 vhost; we render our own into conf.d. Drop it at
    # build time — the non-root runtime user can't remove it from sites-enabled.
    && rm -f /etc/nginx/sites-enabled/default \
    # Adapt the main nginx.conf to a non-root runtime and to our conf.d vhost:
    #  - drop `user` (ignored + warns when not root)
    #  - pid file under a dir the `quant` user owns (passing pid via -g clashes)
    #  - drop the stock `gzip on;` — our default.conf sets the full gzip block
    #    and nginx rejects the directive as duplicate in the same (http) context
    && sed -i -e 's|^user .*|# user directive dropped (non-root runtime);|' \
              -e 's|^pid .*|pid /tmp/nginx/nginx.pid;|' \
              -e '/^\s*gzip on;/d' /etc/nginx/nginx.conf \
    && mkdir -p /app/logs /app/data /var/cache/nginx /tmp/nginx \
    && useradd --system --uid 1001 quant \
    && chown -R quant:quant /app /var/lib/nginx /var/log/nginx /var/cache/nginx \
                            /etc/nginx/conf.d /usr/share/nginx/html /tmp/nginx

ENV SHELL=/bin/bash

COPY api/requirements.txt ./api/requirements.txt
RUN python -m pip install --upgrade pip --root-user-action=ignore \
    && python -m pip install --root-user-action=ignore -r api/requirements.txt

COPY --from=cpp-builder /app/dist/*.whl /tmp/
RUN python -m pip install --root-user-action=ignore --force-reinstall /tmp/*.whl \
    && rm -rf /tmp/*.whl

COPY --chown=quant:quant api ./api
COPY --chown=quant:quant --from=frontend-builder /app/dist /usr/share/nginx/html
COPY web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY web/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY web/entrypoint.sh /entrypoint.sh
# COPY resets ownership to root; re-assert it so the non-root runtime user can
# write /usr/share/nginx/html/config.json and read everything it serves.
RUN chmod +x /entrypoint.sh \
    && chown -R quant:quant /entrypoint.sh /usr/share/nginx/html /app

USER quant

ENV PORT=8080
ENV API_URL=http://127.0.0.1:8000
ARG VITE_COMMIT_SHA=dev
ENV COMMIT_SHA=${VITE_COMMIT_SHA}

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

CMD ["/entrypoint.sh"]
