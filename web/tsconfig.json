{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		// exactOptionalPropertyTypes: dropped. See blueprint/decisions.md ADR-010.
		// It fought every optional React prop passed a `| undefined` value for
		// near-zero bug-catching upside; noUncheckedIndexedAccess (the flag that
		// matters for the grid-with-holes code) is kept.
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"paths": {
			"@/*": ["./src/*"]
		},

		"types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src", "tests", "*.config.ts", ".storybook"]
}
