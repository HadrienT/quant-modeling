# Host ports for docker-compose (change if already in use on your machine —
# useful when running several projects on the same server). Defaults: 8010 / 5180.
QM_API_PORT=
QM_WEB_PORT=

# BigQuery settings for local docker-compose
BQ_PROJECT_ID=
BQ_DATASET_ID=
BQ_TABLE_ID=

# Optional API key (leave blank to disable auth)
API_KEY=
FRED_API_KEY=