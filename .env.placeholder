# Copy to .env. Blueprint WP 14: self-hosted, no Google Cloud required.

# Host ports for docker compose (several projects share this server).
# Defaults: API 8010, web 5180.
QM_API_PORT=
QM_WEB_PORT=

# REQUIRED — a strong random secret. The API refuses to start without it
# (blueprint WP 04). Generate one:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# Account & portfolio storage. "local" = JSON files on the qm_data volume
# (no GCP). Set to "gcs" only if you actually want a bucket.
QM_STORAGE=local

# Market data (prices + macro) is read from the data-ingest Postgres, reached
# over the shared `dataplatform` docker network. Create it once:
#   docker network create dataplatform
# PGPASSWORD must match ~/data-ingest/.env.
PGHOST=data-ingest-postgres
PGPORT=5432
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=

# Build stamp shown in the footer and /health.
COMMIT_SHA=dev
