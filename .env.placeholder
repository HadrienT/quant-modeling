# Copy to .env. Blueprint WP 14: self-hosted, no Google Cloud required.
#
# Development stack (docker-compose.yml): only the dev vars below matter.
# Production stack (docker-compose.prod.yml): also fill CLOUDFLARE_TUNNEL_TOKEN
# (see deploy/RUNBOOK.md §3).

# Cloudflare Tunnel token — create the tunnel in Cloudflare Zero Trust
# (Networks -> Tunnels), it shows a `cloudflared ... run <TOKEN>` command; paste
# just the TOKEN here. It is the only tunnel secret; keep this file gitignored.
CLOUDFLARE_TUNNEL_TOKEN=

# Host ports for docker compose (several projects share this server).
# Dev defaults: API 8010, web 5180.  Prod: web is bound to 127.0.0.1 only,
# default 8091 (local debugging — the tunnel reaches the container internally).
QM_API_PORT=
QM_WEB_PORT=

# REQUIRED — a strong random secret. The API refuses to start without it
# (blueprint WP 04). Generate one:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# Account & portfolio storage. "local" = JSON files on the qm_data volume
# (no GCP). Set to "gcs" only if you actually want a bucket.
QM_STORAGE=local

# CORS allow-list for the prod API (comma-separated). The app is same-origin in
# practice; this only rejects a stray cross-origin caller. Match the hostnames
# in cloudflared/config.yml. Leave unset to use the compose default
# (https://tramonihadrien.com,https://www.tramonihadrien.com).
CORS_ALLOW_ORIGINS=

# Market data (prices + macro) is read from the data-ingest Postgres, reached
# over the shared `dataplatform` docker network. Create it once:
#   docker network create dataplatform
# PGPASSWORD must match ~/data-ingest/.env.
PGHOST=data-ingest-postgres
PGPORT=5432
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=

# Build stamp shown in the footer and /health. deploy.sh overrides this with the
# current git short SHA; leave as "dev" for a manual `docker compose` invocation.
COMMIT_SHA=dev
