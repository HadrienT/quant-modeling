# Copy to .env. Blueprint WP 14: self-hosted, no Google Cloud required.

# Host ports for docker compose (several projects share this server).
# Defaults: API 8010, web 5180.
QM_API_PORT=
QM_WEB_PORT=

# REQUIRED — a strong random secret. The API refuses to start without it
# (blueprint WP 04). Generate one:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# Account & portfolio storage. "local" = JSON files on the qm_data volume
# (no GCP). Set to "gcs" only if you actually want a bucket.
QM_STORAGE=local

# Market data (prices + macro) is read from the data-ingest Postgres.
# PGPASSWORD must match ~/data-ingest/.env. PGHOST defaults to host.docker.internal
# (data-ingest publishes Postgres on 127.0.0.1:5433).
PGHOST=host.docker.internal
PGPORT=5433
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=

# Build stamp shown in the footer and /health.
COMMIT_SHA=dev

# ── Optional ──────────────────────────────────────────────────────────
# FRED (rates curves) and BigQuery (price tape) — leave blank to disable.
FRED_API_KEY=
BQ_PROJECT_ID=
BQ_DATASET_ID=
BQ_TABLE_ID=
